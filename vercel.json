{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/garantidora", "destination": "/lp/garantidora.html" },
    { "source": "/emprestimo", "destination": "/lp/emprestimo.html" },
    { "source": "/compra-garantida", "destination": "/lp/compra-garantida.html" },
    { "source": "/compra-de-divida", "destination": "/lp/compra-de-divida.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
